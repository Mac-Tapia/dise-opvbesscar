# Dockerfile.fastapi
# Imagen API operativa del agente A2C — pvbesscar
# Base: pytorch/pytorch — ya trae torch + CUDA instalados
# Solo descarga: SB3, CityLearn, FastAPI (~50 MB total)

FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime

LABEL maintainer="pvbesscar" \
      version="1.0.0" \
      description="A2C Operational API — REST + WebSocket, pvbesscar OE3"

WORKDIR /app

# Deps del sistema mínimas
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl tini \
    && rm -rf /var/lib/apt/lists/*

# Instalar solo las deps que no trae la imagen base (~50 MB)
COPY requirements.docker.api.txt ./
RUN pip install --no-cache-dir -r requirements.docker.api.txt

# Código fuente del proyecto
COPY src/ ./src/
COPY configs/ ./configs/
COPY fastapi_websocket_server.py ./
COPY scripts/infer/run_a2c_operational.py ./scripts/infer/
COPY setup.py pyproject.toml ./
RUN pip install -e . --no-deps --quiet

# Variables de entorno base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src:/app \
    OMP_NUM_THREADS=4 \
    PORT=8000

# Directorios de runtime (datos y checkpoints se montan como volúmenes)
RUN mkdir -p /app/data/interim/citylearn_v2 \
             /app/checkpoints/A2C_CityLearn \
             /app/outputs/infer \
             /app/logs

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=15s --start-period=60s --retries=3 \
    CMD python -c "\
import urllib.request, json, sys; \
r = urllib.request.urlopen('http://localhost:8000/health', timeout=10); \
d = json.loads(r.read()); \
sys.exit(0 if d.get('model_ready') else 1)"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "fastapi_websocket_server:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--log-level", "info"]
