# .env.operational — Template de variables de entorno para despliegue operativo
# IMPORTANTE: Copiar a .env.local y rellenar los valores reales.
#             NUNCA commitear .env.local con secretos reales.
#
# Uso:
#   cp .env.operational .env.local
#   # Editar .env.local con valores reales
#   docker compose -f docker-compose.operational.yml --env-file .env.local up -d

# ── SEGURIDAD — OBLIGATORIO CAMBIAR ──────────────────────────────
# Clave de acceso a la API (X-API-Key header). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CAMBIAR_POR_CLAVE_ALEATORIA_SEGURA

# Password de MongoDB. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MONGO_INITDB_ROOT_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# Password de Mongo Express (panel admin, solo perfil dev)
MONGO_EXPRESS_PASSWORD=CAMBIAR_POR_PASSWORD_ADMIN

# ── MODELO A2C ────────────────────────────────────────────────────
# Ruta al checkpoint A2C final dentro del contenedor
CHECKPOINT_PATH=/app/checkpoints/A2C_CityLearn/a2c_final

# Ruta al VecNormalize (dejar vacío para auto-detección)
VECNORM_PATH=

# ── BASE DE DATOS ─────────────────────────────────────────────────
MONGODB_URL=mongodb://pvbesscar:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/pvbesscar?authSource=admin
MONGODB_DB=pvbesscar

# ── CORS — Orígenes permitidos (separar con coma) ─────────────────
# En producción: especificar el dominio real del cliente
# En desarrollo: http://localhost:3000,http://localhost:8080
CORS_ORIGINS=http://localhost:3000

# ── CONCURRENCIA ──────────────────────────────────────────────────
# Máx. simulaciones simultáneas (cada episodio toma ~40s en CPU)
MAX_CONCURRENT=2

# ── SERVIDOR ──────────────────────────────────────────────────────
PORT=8000
WORKERS=1

# ── PYTHON ───────────────────────────────────────────────────────
OMP_NUM_THREADS=4
